{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": null,
  "outputDirectory": "public",
  "framework": null,
  "headers": [
    {
      "source": "/site_status.json",
      "headers": [
        {"key": "Cache-Control", "value": "no-store, max-age=0"}
      ]
    },
    {
      "source": "/variance_shadow.json",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=0, s-maxage=30, must-revalidate"},
        {"key": "CDN-Cache-Control", "value": "max-age=30"},
        {"key": "Content-Type", "value": "application/json; charset=utf-8"}
      ]
    },
    {
      "source": "/archive/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}
      ]
    },
    {
      "source": "/(signals|signals_replay|hybrid_forecast)\\.json",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=0, s-maxage=30, must-revalidate"},
        {"key": "CDN-Cache-Control", "value": "max-age=30"},
        {"key": "Content-Type", "value": "application/json; charset=utf-8"}
      ]
    },
    {
      "source": "/(latest|accuracy|history)\\.json",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=60, s-maxage=60, stale-while-revalidate=600"}
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=300, s-maxage=300"}
      ]
    },
    {
      "source": "/v2.html",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=0, s-maxage=60, must-revalidate"}
      ]
    },
    {
      "source": "/",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=0, s-maxage=60, must-revalidate"}
      ]
    },
    {
      "source": "/outlook.html",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=0, s-maxage=60, must-revalidate"},
        {"key": "CDN-Cache-Control", "value": "max-age=30"},
        {"key": "Content-Type", "value": "text/html; charset=utf-8"},
        {"key": "Content-Security-Policy", "value": "default-src 'none'; style-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"}
      ]
    },
    {
      "source": "/ko/",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=0, s-maxage=60, must-revalidate"}
      ]
    },
    {
      "source": "/ko/index.html",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=0, s-maxage=60, must-revalidate"}
      ]
    },
    {
      "source": "/privacy.html",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=0, s-maxage=60, must-revalidate"},
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}
      ]
    },
    {
      "source": "/signals_segments.csv",
      "headers": [
        {"key": "Content-Type", "value": "text/csv; charset=utf-8"},
        {"key": "CDN-Cache-Control", "value": "max-age=30"}
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "data/daily-forecast": true
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/v2.html"
    },
    {
      "source": "/variance_shadow.json",
      "destination": "https://raw.githubusercontent.com/wscha231/eth-dashboard/data/event-ledger/lake/event-ledger/variance-shadow/public.json"
    },
    {
      "source": "/signals.json",
      "destination": "https://raw.githubusercontent.com/wscha231/eth-dashboard/data/event-feed/forecast_site/public/signals.json"
    },
    {
      "source": "/signals_replay.json",
      "destination": "https://raw.githubusercontent.com/wscha231/eth-dashboard/data/event-feed/forecast_site/public/signals_replay.json"
    },
    {
      "source": "/signals_segments.csv",
      "destination": "https://raw.githubusercontent.com/wscha231/eth-dashboard/data/event-feed/forecast_site/public/signals_segments.csv"
    },
    {
      "source": "/outlook.html",
      "destination": "https://raw.githubusercontent.com/wscha231/eth-dashboard/data/event-feed/forecast_site/public/outlook.html"
    },
    {
      "source": "/archive/:path*",
      "destination": "https://raw.githubusercontent.com/wscha231/eth-dashboard/data/event-feed/forecast_site/public/archive/:path*"
    }
  ]
}
