# =============================================================================
# Example .env for the codex project.
# Copy to .env and fill in values. NEVER commit .env itself (gitignored).
# =============================================================================

# --- FRED (Federal Reserve Economic Data) --------------------------
# Free: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# --- Etherscan (on-chain + donation tracking) ----------------------
# Free tier: 5 calls/sec, 100k/day.
# Sign up: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# --- CoinGecko Pro (optional — free tier OK for daily) -------------
# Pro plan ~$129/mo enables extended historical endpoints.
# COINGECKO_API_KEY=

# --- Glassnode (optional — paid only) ------------------------------
# GLASSNODE_API_KEY=

# --- Alchemy (Ethereum RPC) ----------------------------------------
# Free: 300M compute units/month.
ALCHEMY_API_KEY=

# --- Dune Analytics ------------------------------------------------
# Free tier: 40 credits/day.
DUNE_API_KEY=

# --- Anthropic (optional — LLM analyst / news NLP) -----------------
# Sign up at console.anthropic.com for free credits.
# ANTHROPIC_API_KEY=

# --- Donation wallet addresses (public — used by donation_tracker.py)
DONATION_BTC_ADDRESS=
DONATION_ETH_ADDRESS=
DONATION_SOL_ADDRESS=
DONATION_TRX_ADDRESS=
